    {
      "parameters": {
        "content": "### Do formulário ao pedido\nEm **Variáveis**, os campos vêm de `body`. Um campo ausente vira texto vazio. Em **Normalizar Dados**, confira o e-mail da Marina em minúsculas e o WhatsApp só com dígitos.",
        "width": 460,
        "height": 175,
        "color": 5
      },
      "id": "824db354-f6b0-4e41-8858-20d7791a4773",
      "name": "Conferir a entrada",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\nconst prazo = { 'este-mes': 40, 'proximo-trimestre': 25, pesquisando: 5 };\nconst porte = { '200+': 25, '51-200': 20, '11-50': 10, '1-10': 5 };\nconst pessoais = [\n  'gmail.com', 'hotmail.com', 'outlook.com', 'yahoo.com.br', 'yahoo.com'\n];\nconst dominio = (lead.email || '').split('@')[1] || '';\nconst nota = (prazo[lead.prazo] || 0) + (porte[lead.porte] || 0)\n  + (dominio && !pessoais.includes(dominio) ? 15 : 0)\n  + (lead.whatsapp ? 10 : 0) + (lead.empresa ? 10 : 0);\nreturn { json: {\n  ...lead, nota,\n  faixa: nota >= 70 ? 'quente' : nota >= 40 ? 'morno' : 'frio',\n  etapa: 'Novo lead'\n} };"
      },
      "id": "8a06bb37-d7a3-404e-81bc-13bb3098bde9",
      "name": "Nota do lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        0
      ]
    },
