    },
    {
      "parameters": {
        "content": "### Sem laço\n\nEntraram 6 itens, o nó tratou os 6. Não foi preciso laço.",
        "height": 139,
        "width": 260,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        520,
