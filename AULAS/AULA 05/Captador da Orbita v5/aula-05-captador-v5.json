      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ 'Recebemos seu pedido, ' + $('Nota do lead').first().json.nome + '!' + ($('Nota do lead').first().json.faixa === 'quente' ? ' Um consultor fala com você ainda hoje.' : ' Nossa equipe entrará em contato.') }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
